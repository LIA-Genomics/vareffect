{
  "permissions": {
    "deny": [
      "Edit(/.claude/INVARIANTS.md)",
      "Read(//**/*.env)",
      "Read(//**/*.jks)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pem)",
      "Read(//**/*.pfx)",
      "Read(//**/*credentials*.json)",
      "Read(//**/.aws/credentials)",
      "Read(//**/.cargo/credentials*)",
      "Read(//**/.config/gcloud/**)",
      "Read(//**/.config/gh/hosts.yml)",
      "Read(//**/.docker/config.json)",
      "Read(//**/.doppler/**)",
      "Read(//**/.env)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.backup)",
      "Read(//**/.env.bak)",
      "Read(//**/.env.ci)",
      "Read(//**/.env.dev)",
      "Read(//**/.env.development)",
      "Read(//**/.env.docker)",
      "Read(//**/.env.local)",
      "Read(//**/.env.old)",
      "Read(//**/.env.prod)",
      "Read(//**/.env.production)",
      "Read(//**/.env.qa)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.test)",
      "Read(//**/.env.uat)",
      "Read(//**/.envrc)",
      "Read(//**/.git-credentials)",
      "Read(//**/.kube/config)",
      "Read(//**/.netrc)",
      "Read(//**/.npmrc)",
      "Read(//**/.pgpass)",
      "Read(//**/.pypirc)",
      "Read(//**/.ssh/**)",
      "Read(//**/id_dsa)",
      "Read(//**/id_ecdsa)",
      "Read(//**/id_ed25519)",
      "Read(//**/id_rsa)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/pin-reviewer-models.py\"; if [ ! -f \"$f\" ]; then a=\"$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)\"; b=\"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)\"; if [ \"${a#/}\" != \"$a\" ] && [ \"$a\" = \"$b\" ]; then f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/pin-reviewer-models.py\"; fi; fi; python3 \"$f\" || exit 2"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "effortLevel": "high"
}
